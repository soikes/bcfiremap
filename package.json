{
  "name": "bcfiremap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=.env.template --env-file=.env --hot server.ts",
    "build": "bun --env-file=.env.template --env-file=.env build --target=bun --production --env='PUBLIC_*' --outdir=dist server.ts",
    "start": "cd dist && NODE_ENV=production bun server.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "maplibre-gl": "5.24.1",
    "polygon-clipping": "^0.15.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/bun": "1.3.10",
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
